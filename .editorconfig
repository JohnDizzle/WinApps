root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Browser/*.cs]
# Reactor owns reconciled properties and declarative event subscriptions.
dotnet_diagnostic.REACTOR_POOL_001.severity = error
dotnet_diagnostic.REACTOR_EVENT_001.severity = error
dotnet_diagnostic.REACTOR_MOD_003.severity = error
dotnet_diagnostic.REACTOR_VIS_001.severity = error

[docs/licenses/*.txt]
trim_trailing_whitespace = false
insert_final_newline = false
